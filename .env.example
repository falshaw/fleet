# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_password_here
REDIS_PASSWORD=your_secure_password_here

# Prisma CLI and seed, run from the host (schema push needs the owner account,
# not the app user). Same password as POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://fleet:your_secure_password_here@127.0.0.1:5441/fleet_db

# Auth (NextAuth v5)
# Generate with: openssl rand -base64 32 (must be >= 32 chars)
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3008

# Least-privilege app DB user (created by postgres/init-app-user.sh)
# Generate with: openssl rand -base64 32
FLEET_APP_PASSWORD=your_app_db_password_here

# Fleet Agent secret (shared between app and agent containers)
# Generate with: openssl rand -base64 32
FLEET_AGENT_SECRET=your_fleet_agent_secret_here

# AES-256-GCM key for the Telegram bot token at rest; generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Shared secret for the fleet-cron sidecar (metrics + alerts every 5 minutes)
# Generate with: openssl rand -hex 32
CRON_SECRET=
