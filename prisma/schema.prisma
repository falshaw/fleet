generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Auth Models (NextAuth v5)
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  image         String?
  role          String    @default("MEMBER")
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  deployLogs    DeployLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// Fleet Models
// =============================================================================

model DeployLog {
  id          String   @id @default(cuid())
  appName     String
  action      String
  status      String
  details     String?
  userId      String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([appName])
  @@index([createdAt])
}

// FL-01: Telegram Alert Configuration
model AlertConfig {
  id               String   @id @default(cuid())
  enabled          Boolean  @default(false)
  telegramBotToken String?
  telegramChatId   String?
  alertTypes       Json     @default("[]")
  cooldownMinutes  Int      @default(15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// FL-01: Alert History Log
model AlertLog {
  id            String   @id @default(cuid())
  type          String
  containerName String
  message       String
  sentAt        DateTime @default(now())

  @@index([type])
  @@index([sentAt])
  @@index([containerName])
}

// FL-02: Historical Container Metrics
model ContainerMetric {
  id            String   @id @default(cuid())
  containerName String
  cpuPercent    Float
  memoryUsedMB  Float
  memoryLimitMB Float
  networkRxMB   Float    @default(0)
  networkTxMB   Float    @default(0)
  diskUsedMB    Float    @default(0)
  recordedAt    DateTime @default(now())

  @@index([containerName])
  @@index([recordedAt])
  @@index([containerName, recordedAt])
}

// FL-03: Deploy Action History
model DeployAction {
  id            String    @id @default(cuid())
  containerName String
  action        String
  status        String    @default("PENDING")
  output        String?
  triggeredBy   String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([containerName])
  @@index([startedAt])
}
